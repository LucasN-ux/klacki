{
  "id": "character-animator",
  "name": "Character Animator",
  "initials": "CH",
  "family": "2d-realtime",
  "version": "2026",
  "docUrl": "https://helpx.adobe.com/adobe-character-animator/desktop/introduction/keyboard-shortcuts.html",
  "verifiedAt": "2026-09-27",
  "shortcuts": [
    {
      "id": "undo",
      "category": "general",
      "action": {
        "en": "Undo",
        "fr": "Annuler"
      },
      "keys": {
        "win": [["Ctrl", "Z"]],
        "mac": [["Cmd", "Z"]]
      }
    },
    {
      "id": "redo",
      "category": "general",
      "action": {
        "en": "Redo",
        "fr": "Rétablir"
      },
      "keys": {
        "win": [["Ctrl", "Shift", "Z"]],
        "mac": [["Cmd", "Shift", "Z"]]
      }
    },
    {
      "id": "new-project",
      "category": "file",
      "action": {
        "en": "New project",
        "fr": "Nouveau projet"
      },
      "keys": {
        "win": [["Ctrl", "Alt", "N"]],
        "mac": [["Cmd", "Option", "N"]]
      }
    },
    {
      "id": "open-file",
      "category": "file",
      "action": {
