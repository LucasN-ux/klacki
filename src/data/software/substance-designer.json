      "category": "tools",
      "action": {
        "en": "Open the node menu",
        "fr": "Ouvrir le menu des nœuds"
      },
      "context": {
        "en": "Graph view",
        "fr": "Vue graphe"
      },
      "keys": {
        "win": [["Space"]],
        "mac": [["Space"]]
      }
    },
