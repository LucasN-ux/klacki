{
  "id": "substance-designer",
  "name": "Substance Designer",
  "initials": "SD",
  "family": "texture",
  "version": "16.0",
  "docUrl": "https://substance3d.adobe.com/documentation/sddoc/shortcuts-102400015.html",
  "verifiedAt": "2026-09-20",
  "shortcuts": [
    {
      "id": "new-project",
      "category": "file",
      "action": {
        "en": "New Substance graph",
        "fr": "Nouveau graphe Substance"
      },
      "keys": {
        "win": [["Ctrl", "N"]],
        "mac": [["Cmd", "N"]]
      }
    },
    {
      "id": "open-file",
      "category": "file",
      "action": {
        "en": "Load a package",
        "fr": "Charger un paquet"
      },
      "keys": {
        "win": [["Ctrl", "O"]],
        "mac": [["Cmd", "O"]]
      }
    },
    {
      "id": "close-project",
      "category": "file",
      "action": {
        "en": "Close the selected packages",
        "fr": "Fermer les paquets sélectionnés"
      },
      "keys": {
        "win": [["Ctrl", "F4"]],
        "mac": [["Cmd", "W"]]
      }
    },
    {
      "id": "save-file",
      "category": "file",
      "action": {
        "en": "Save the package",
        "fr": "Enregistrer le paquet"
      },
      "keys": {
        "win": [["Ctrl", "S"]],
        "mac": [["Cmd", "S"]]
      }
    },
    {
      "id": "undo",
      "category": "general",
      "action": {
        "en": "Undo",
        "fr": "Annuler"
      },
      "keys": {
        "win": [["Ctrl", "Z"]],
        "mac": [["Cmd", "Z"]]
      }
    },
    {
      "id": "redo",
      "category": "general",
      "action": {
        "en": "Redo",
        "fr": "Rétablir"
      },
      "keys": {
        "win": [["Ctrl", "Y"]],
        "mac": [["Cmd", "Y"]]
      }
    },
    {
