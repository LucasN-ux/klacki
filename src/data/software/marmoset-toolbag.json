{
  "id": "marmoset-toolbag",
  "name": "Marmoset Toolbag",
  "initials": "MT",
  "family": "render-sim-terrain",
  "version": "5",
  "docUrl": "https://docs.marmoset.co/docs/keyboard-shortcuts/",
  "verifiedAt": "2026-09-22",
  "shortcuts": [
    {
      "id": "undo",
      "category": "general",
      "action": {
        "en": "Undo",
        "fr": "Annuler"
      },
      "keys": {
        "win": [["Ctrl", "Z"]],
        "mac": [["Ctrl", "Z"]]
      }
    },
    {
      "id": "redo",
      "category": "general",
      "action": {
        "en": "Redo",
        "fr": "Rétablir"
      },
      "keys": {
        "win": [["Shift", "Ctrl", "Z"]],
        "mac": [["Shift", "Ctrl", "Z"]]
      }
    },
    {
      "id": "save-file",
      "category": "file",
      "action": {
        "en": "Save",
        "fr": "Enregistrer"
      },
      "keys": {
        "win": [["Ctrl", "S"]],
        "mac": [["Ctrl", "S"]]
      }
    },
    {
      "id": "open-file",
      "category": "file",
      "action": {
        "en": "Open a file",
        "fr": "Ouvrir un fichier"
      },
      "keys": {
        "win": [["Ctrl", "O"]],
        "mac": [["Ctrl", "O"]]
      }
    },
