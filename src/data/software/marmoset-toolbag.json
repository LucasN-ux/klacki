      "category": "navigation",
      "action": {
        "en": "Orbit the camera",
        "fr": "Orbiter la caméra"
      },
      "context": {
        "en": "Viewport",
        "fr": "Vue 3D"
      },
      "keys": {
        "win": [["Alt", "MouseLeft"]],
        "mac": [["Option", "MouseLeft"]]
      }
    },
