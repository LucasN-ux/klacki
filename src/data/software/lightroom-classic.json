{
  "id": "lightroom-classic",
  "name": "Lightroom Classic",
  "initials": "LC",
  "family": "photo-image",
  "version": "2026",
  "docUrl": "https://helpx.adobe.com/lightroom-classic/desktop/introduction-to-lightroom-classic/keyboard-shortcuts.html",
  "verifiedAt": "2026-09-27",
  "undocumented": ["save-file"],
  "shortcuts": [
    {
      "id": "undo",
      "category": "general",
      "action": {
        "en": "Undo",
        "fr": "Annuler"
      },
      "keys": {
        "win": [["Ctrl", "Z"]],
        "mac": [["Cmd", "Z"]]
      }
    },
    {
      "id": "redo",
      "category": "general",
      "action": {
        "en": "Redo",
        "fr": "Rétablir"
      },
      "keys": {
        "win": [
          ["Ctrl", "Shift", "Z"],
          ["Ctrl", "Y"]
        ],
        "mac": [["Cmd", "Shift", "Z"]]
      }
    },
    {
      "id": "open-file",
      "category": "file",
      "action": {
        "en": "Open a catalog",
        "fr": "Ouvrir un catalogue"
      },
      "keys": {
        "win": [["Ctrl", "O"]],
        "mac": [["Cmd", "Shift", "O"]]
      }
    },
    {
      "id": "import",
      "category": "file",
      "action": {
        "en": "Import photos from disk",
        "fr": "Importer des photos depuis le disque"
      },
      "keys": {
        "win": [["Ctrl", "Shift", "I"]],
        "mac": [["Cmd", "Shift", "I"]]
      }
    },
    {
      "id": "export-selected",
      "category": "file",
      "action": {
        "en": "Export the selected photos",
        "fr": "Exporter les photos sélectionnées"
      },
      "keys": {
        "win": [["Ctrl", "Shift", "E"]],
        "mac": [["Cmd", "Shift", "E"]]
      }
    },
    {
      "id": "export-previous",
      "category": "file",
      "action": {
        "en": "Export with the previous settings",
        "fr": "Exporter avec les réglages précédents"
      },
      "keys": {
        "win": [["Ctrl", "Alt", "Shift", "E"]],
        "mac": [["Cmd", "Option", "Shift", "E"]]
      }
    },
    {
      "id": "print",
      "category": "file",
      "action": {
        "en": "Print",
        "fr": "Imprimer"
      },
      "keys": {
        "win": [["Ctrl", "P"]],
        "mac": [["Cmd", "P"]]
      }
    },
    {
      "id": "select-all",
      "category": "selection",
      "action": {
        "en": "Select everything",
        "fr": "Tout sélectionner"
      },
      "keys": {
        "win": [["Ctrl", "A"]],
        "mac": [["Cmd", "A"]]
      }
    },
    {
      "id": "deselect-all",
      "category": "selection",
      "action": {
        "en": "Deselect everything",
        "fr": "Tout désélectionner"
      },
      "keys": {
        "win": [["Ctrl", "D"]],
        "mac": [
          ["Cmd", "D"],
          ["Cmd", "Shift", "A"]
        ]
      }
    },
    {
      "id": "rename-photo",
      "category": "edit",
      "action": {
        "en": "Rename the photo",
        "fr": "Renommer la photo"
      },
      "keys": {
        "win": [["F2"]],
        "mac": [["F2"]]
      }
    },
    {
      "id": "delete-photo",
      "category": "edit",
      "action": {
        "en": "Delete the selected photos",
        "fr": "Supprimer les photos sélectionnées"
      },
      "keys": {
        "win": [["Backspace"], ["Delete"]],
        "mac": [["Delete"]]
      }
    },
    {
      "id": "virtual-copy",
      "category": "edit",
      "action": {
        "en": "Create a virtual copy",
        "fr": "Créer une copie virtuelle"
      },
      "keys": {
        "win": [["Ctrl", "'"]],
        "mac": [["Cmd", "'"]]
      }
    },
    {
