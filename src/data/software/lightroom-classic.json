      "category": "edit",
      "action": {
        "en": "Rotate the photo clockwise",
        "fr": "Faire pivoter la photo à droite"
      },
      "keys": {
        "win": [["Ctrl", "]"]],
        "mac": [["Cmd", "]"]]
      }
    },
    {
      "id": "rotate-left",
      "category": "edit",
      "action": {
        "en": "Rotate the photo counterclockwise",
        "fr": "Faire pivoter la photo à gauche"
      },
      "keys": {
        "win": [["Ctrl", "["]],
        "mac": [["Cmd", "["]]
      }
    },
    {
