      "category": "edit",
      "action": {
        "en": "Flag as a pick",
        "fr": "Marquer comme retenue"
      },
      "keys": {
        "win": [["P"]],
        "mac": [["P"]]
      }
    },
    {
      "id": "flag-reject",
      "category": "edit",
      "action": {
        "en": "Flag as a reject",
        "fr": "Marquer comme rejetée"
      },
      "keys": {
        "win": [["X"]],
        "mac": [["X"]]
      }
    },
    {
      "id": "rate-1",
      "category": "edit",
      "action": {
        "en": "Rate one star",
        "fr": "Noter une étoile"
      },
      "keys": {
        "win": [["1"]],
        "mac": [["1"]]
      }
    },
    {
      "id": "rate-5",
      "category": "edit",
      "action": {
        "en": "Rate five stars",
        "fr": "Noter cinq étoiles"
      },
      "keys": {
        "win": [["5"]],
        "mac": [["5"]]
      }
    },
    {
      "id": "remove-rating",
      "category": "edit",
      "action": {
        "en": "Remove the star rating",
        "fr": "Retirer la note"
      },
      "keys": {
        "win": [["0"]],
        "mac": [["0"]]
      }
    },
    {
      "id": "copy-develop-settings",
