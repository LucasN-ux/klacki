      "action": {
        "en": "Copy the Develop settings",
        "fr": "Copier les réglages Développement"
      },
      "keys": {
        "win": [["Ctrl", "Shift", "C"]],
        "mac": [["Cmd", "Shift", "C"]]
      }
    },
    {
