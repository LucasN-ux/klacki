      "action": {
        "en": "Paste the Develop settings",
        "fr": "Coller les réglages Développement"
      },
      "keys": {
        "win": [["Ctrl", "Shift", "V"]],
        "mac": [["Cmd", "Shift", "V"]]
      }
    },
    {
      "id": "paste-previous-settings",
      "category": "edit",
      "action": {
        "en": "Paste the settings of the previous photo",
