      },
      "keys": {
        "win": [["Ctrl", "Alt", "V"]],
        "mac": [["Cmd", "Option", "V"]]
      }
    },
    {
      "id": "auto-tone",
      "category": "edit",
      "action": {
        "en": "Auto tone",
        "fr": "Tonalité automatique"
      },
      "keys": {
        "win": [["Ctrl", "U"]],
        "mac": [["Cmd", "U"]]
      }
    },
    {
