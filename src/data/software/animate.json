{
  "id": "animate",
  "name": "Animate",
  "initials": "AN",
  "family": "2d-realtime",
  "version": "2026",
  "docUrl": "https://helpx.adobe.com/animate/desktop/introduction-to-animate/animate-keyboard-shortcuts.html",
